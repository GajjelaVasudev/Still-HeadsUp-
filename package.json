{
  "name": "still-headsup",
  "productName": "Still",
  "version": "1.2.0",
  "description": "Premium Persistent Windows Desktop Task Reminder",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:vite && npm run build:electron",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && npm run build:electron && electron .\"",
    "start": "npm run build && electron .",
    "test": "tsc -p tsconfig.test.json && node dist-test/test/engine.test.js && node dist-test/test/overdueBanner.test.js",
    "dist": "npm run build && node scripts/package-win.js"
  },
  "build": {
    "appId": "com.headsup.still",
    "productName": "Still",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/sql.js/dist/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
